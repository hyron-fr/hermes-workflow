model:
  default: deepseek-v4.1-flash:cloud
  provider: litellm-proxy-gcp
providers:
  litellm-proxy-gcp:
    base_url: http://${LITELLM_BASE_HOST}/v1
    api_key: ${LITELLM_API_KEY}
    models:
      - qwen3.8-27b
      - gemma4:31b-cloud
      - qwen3.5:cloud
      - glm-5.3-flash:cloud
      - glm-5.3:cloud
      - deepseek-v4-pro:cloud
      - deepseek-v4-flash:cloud
      - deepseek-v4.1-flash:cloud
      - minimax-m3:cloud
      - kimi-k2.7-code:cloud
      - kimi-k3:cloud
      - nemotron-3-ultra:cloud
      - nemotron-3-ultra:nim
      - nemotron-3-super:nim
      - nemotron-3.5-lightning:nim
      - nemotron-3-nano-omni:nim
      - kimi-k3:nim
      - muse-glimmer:nim
      - deepseek-v4-pro:nim
      - deepseek-v4-flash:nim
      - gemma-4-31b:nim
      - nim:auto
      - nim-vision:auto
    request_timeout_seconds: 600
    default_model: deepseek-v4.1-flash:cloud
memory:
  provider: hindsight
kanban:
  dispatch_in_gateway: true
toolsets:
  - kanban
  - file
  - terminal
  - web
  - skills
  - memory
  - delegation
  - session_search
  - code_execution
  - todo
agent:
  max_turns: 150
_config_version: 45
onboarding:
  seen:
    tool_progress_prompt: true
plugins:
  enabled: []
