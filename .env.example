# Secrets à placer dans ~/.hermes/profiles/<profil>/.env — JAMAIS dans ce dépôt.
# Copier ce fichier, renseigner les valeurs, ne pas le committer.

# Accès au proxy d'inférence (LiteLLM ou compatible OpenAI)
LITELLM_API_KEY=

# Bot Discord (un token n'appartient qu'à UN profil à la fois)
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_ALLOWED_USERS=
DISCORD_FREE_RESPONSE_CHANNELS=

# Board kanban par défaut du profil
HERMES_KANBAN_BOARD=pj

# Mémoire projet (Hindsight)
HINDSIGHT_MODE=
HINDSIGHT_API_URL=
HINDSIGHT_API_KEY=
